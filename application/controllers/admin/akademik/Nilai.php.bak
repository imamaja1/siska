    public function filter_distribusi() {
        $kode_tahun_akademik = $this->input->post('kode_tahun_akademik');
        $kode_program_studi = $this->input->post('kode_program_studi');
        $res['kode_tahun_akademik'] = $kode_tahun_akademik;
        $res['kode_program_studi'] = $kode_program_studi;

        $data_kelas = $this->db->select('kelas.kelas_id, nama_matakuliah, nama_kelas, semester, group_concat(nama_dosen) as nama_dosen')
                        ->from('kelas')
                        ->join('matakuliah as mak', 'mak.id_matakuliah=kelas.id_matakuliah')
                        ->join('nama_kelas', 'nama_kelas.nama_kelas_id=kelas.nama_kelas_id')
                        ->join('mengajar', 'mengajar.kelas_id=kelas.kelas_id', 'left')
                        ->join('dosen', 'mengajar.kode_dosen=dosen.kode_dosen', 'left')
                        ->where('kelas.kode_tahun_akademik', $kode_tahun_akademik)
                        ->where('kelas.kode_program_studi', $kode_program_studi)
                        ->order_by('mak.nama_matakuliah')
                        ->group_by('kelas.kelas_id')
                        ->get()->result_object();
//        echo "<pre>";
//        print_r($data_kelas);
//        die();
        $i = 0;
        $data = array();
        foreach ($data_kelas as $row) {
            if(!$row->nama_dosen){
                continue;
            }
            $data[$i]['nama_kelas'] = $row->nama_kelas;
            $data[$i]['nama_matakuliah'] = $row->nama_matakuliah;
            $data[$i]['semester'] = $row->semester;
            $data[$i]['nama_dosen'] = $row->nama_dosen;
//            $total = $this->db->select('grade, nilai_akhir')
            $total = $this->db->select('*')
//                    ->from('kelas_mahasiswa as km, sistem_penilaian_detail as spd')
                            ->from('kelas_mahasiswa as km')
                            ->join('krs_detail as kd', 'kd.kode_krs_detail=km.kode_krs_detail', 'left')
                            ->join('khs_detail as khd', 'khd.kode_krs_detail=kd.kode_krs_detail', 'left')
                            ->where('kelas_id', $row->kelas_id)
//                    ->where('spd.kode_sistem_penilaian','1')
//                    ->where('spd.nilai_minimum <= khd.nilai_akhir')
//                    ->where('spd.nilai_maksimum >= khd.nilai_akhir')
              				
                            ->get()->num_rows();
            $data[$i]['total'] = $total;
            $sub_query = $this->db->select('grade, nilai_akhir, count(kd.kode_krs_detail) as jumlah')
                            ->from('kelas_mahasiswa as km, sistem_penilaian_detail as spd')
                            ->join('krs_detail as kd', 'kd.kode_krs_detail=km.kode_krs_detail', 'left')
                            ->join('khs_detail as khd', 'khd.kode_krs_detail=kd.kode_krs_detail', 'left')
                            ->where('kelas_id', $row->kelas_id)
                            ->where('spd.kode_sistem_penilaian', '1')
                            ->where('spd.nilai_minimum <= khd.nilai_akhir')
                            ->where('spd.nilai_maksimum >= khd.nilai_akhir')
              				//->group_by('khd.kode_krs_detail')->get_compiled_select();
                            ->group_by('grade')->get_compiled_select();

            $data[$i]['data'] = $this->db->select("jumlah, (jumlah/$total)*100 as persen")
                            ->from("($sub_query) as m")
                            ->join('sistem_penilaian_detail as spd', 'spd.grade=m.grade', 'right')
                            ->where('spd.kode_sistem_penilaian', '1')
                            ->get()->result_object();
            $i++;
        }
        $res['data'] = $data;
        $this->load->view('admin/akademik/nilai/distribusi_nilai/V_lists', $res);
    }

    public function distribusi_excel($kode_tahun_akademik, $kode_program_studi) {
        $res['tahun_akademik'] = $this->db->where('kode_tahun_akademik', $kode_tahun_akademik)->get('tahun_akademik')->row_object();
        $res['program_studi'] = $this->db->where('kode_program_studi', $kode_program_studi)->get('program_studi')->row_object();
        $data_kelas = $this->db->select('kelas.kelas_id, nama_matakuliah, nama_kelas, semester, group_concat(nama_dosen) as nama_dosen')
                        ->from('kelas')
                        ->join('matakuliah as mak', 'mak.id_matakuliah=kelas.id_matakuliah')
                        ->join('nama_kelas', 'nama_kelas.nama_kelas_id=kelas.nama_kelas_id')
                        ->join('mengajar', 'mengajar.kelas_id=kelas.kelas_id', 'left')
                        ->join('dosen', 'mengajar.kode_dosen=dosen.kode_dosen', 'left')
                        ->where('kelas.kode_tahun_akademik', $kode_tahun_akademik)
                        ->where('kelas.kode_program_studi', $kode_program_studi)
                        ->order_by('mak.nama_matakuliah')
                        ->group_by('kelas.kelas_id')
                        ->get()->result_object();
        ;
        $i = 0;
        $data = array();
        foreach ($data_kelas as $row) {
            if(!$row->nama_dosen){
                continue;
            }
            $data[$i]['nama_kelas'] = $row->nama_kelas;
            $data[$i]['nama_matakuliah'] = $row->nama_matakuliah;
            $data[$i]['semester'] = $row->semester;
            $data[$i]['nama_dosen'] = $row->nama_dosen;
            $total = $this->db->select('grade, nilai_akhir')
                            ->from('kelas_mahasiswa as km, sistem_penilaian_detail as spd')
                            ->join('krs_detail as kd', 'kd.kode_krs_detail=km.kode_krs_detail', 'left')
                            ->join('khs_detail as khd', 'khd.kode_krs_detail=kd.kode_krs_detail', 'left')
                            ->where('kelas_id', $row->kelas_id)
                            ->where('spd.kode_sistem_penilaian', '1')
                            ->where('spd.nilai_minimum <= khd.nilai_akhir')
                            ->where('spd.nilai_maksimum >= khd.nilai_akhir')
                            ->get()->num_rows();
            $data[$i]['total'] = $total;
            $sub_query = $this->db->select('grade, nilai_akhir, count(kd.kode_krs_detail) as jumlah')
                            ->from('kelas_mahasiswa as km, sistem_penilaian_detail as spd')
                            ->join('krs_detail as kd', 'kd.kode_krs_detail=km.kode_krs_detail', 'left')
                            ->join('khs_detail as khd', 'khd.kode_krs_detail=kd.kode_krs_detail', 'left')
                            ->where('kelas_id', $row->kelas_id)
                            ->where('spd.kode_sistem_penilaian', '1')
                            ->where('spd.nilai_minimum <= khd.nilai_akhir')
                            ->where('spd.nilai_maksimum >= khd.nilai_akhir')
                            ->group_by('grade')->get_compiled_select();

            $data[$i]['data'] = $this->db->select("jumlah, (jumlah/$total)*100 as persen")
                            ->from("($sub_query) as m")
                            ->join('sistem_penilaian_detail as spd', 'spd.grade=m.grade', 'right')
                            ->where('spd.kode_sistem_penilaian', '1')
                            ->get()->result_object();
            $i++;
        }
        $semester = $res['tahun_akademik']->semester == '1' ? "GANJIL" : 'GENAP';
        $res['data'] = $data;
        $res['filename'] = "REKAPITULASI PENDISTRIBUSIAN NILAI PROGRAM STUDI " . strtoupper($res['program_studi']->nama_program_studi) . " SEMESTER " . $semester . " " . $res['tahun_akademik']->tahun_akademik;
        $this->load->view('admin/akademik/nilai/distribusi_nilai/Excel', $res);
    }

}
